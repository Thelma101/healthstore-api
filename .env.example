# Server Configuration
NODE_ENV=production
PORT=3000

# Database (use MongoDB Atlas for production)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/pharmastore

# JWT Authentication
JWT_SECRET=generate-a-64-char-random-secret-here
JWT_EXPIRE=1d
JWT_COOKIE_EXPIRE=86400000

# CORS (set to your frontend URL, or * for public API)
CORS_ORIGIN=*

# SendGrid Email Service
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_VERIFIED_SENDER=your-verified-email@example.com

# Client URL (used in email links - set to your Render URL)
CLIENT_URL=https://your-app-name.onrender.com

# Cloudinary (Image Uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
